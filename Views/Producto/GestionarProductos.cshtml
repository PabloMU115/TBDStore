@using TBD.Models.ViewModels
@model AgregarProductoViewModel
@{
}
<!-- Botón para abrir el modal -->
<div class="container card p-4" style="color:white;">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Listado de Productos</h2>
		<button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#ModalCrear">
			<i class="fa-solid fa-square-plus"></i> Agregar Producto 
		</button>
	</div>

	<div class="table-responsive">
		<table id="tabla-productos" class="display table table-bordered table-hover">
			<thead>
				<tr>
					<th class="text-center">ID</th>
					<th class="text-center">Nombre</th>
					<th class="text-center">Categoría</th>
					<th class="text-center">Precio</th>
					<th class="text-center">Stock</th>
					<th class="text-center">Opciones</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var p in Model.Productos)
				{
					<tr class="tr-tabla">
						<td class="id" id="@p.Id">
							@p.Id
							</td>
						<td>
							<a class="nombre" id="@p.Nombre"
							   asp-controller="Producto"
							   asp-action="GetProducto"
							   asp-route-id="@p.Id"
							   asp-route-nombre="@p.Nombre"
							   asp-route-idCategoria="@p.IdCategoria">@p.Nombre</a>
						</td>
						<td>
							<a asp-controller="Categoria"
							   asp-action="Index"
							   asp-route-filter="1"
							   asp-route-id="@p.IdCategoria"
							   asp-route-nombre="@p.NombreCategoria"
							   asp-route-pageNumber="1"
							   asp-route-showAll="@false">@p.NombreCategoria</a>
						</td>
						<td>₡@p.Precio</td>
						<td>@p.Stock</td>
						<td>
							<button class="btn-editarProducto btn-warning" onclick="openEdit(this)"><i class="fa-solid fa-pen-to-square"></i></button>
							<button class="btn-eliminarProducto btn-danger" onclick="openDelete(this)"><i class="fa-solid fa-trash-can"></i></button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="ModalCrear" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalCrearLabel" aria-hidden="true" style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalCrearLabel">Agregar un producto nuevo</h5>
				<button type="button" class="btn-close" onclick="cerrarCrear()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-producto">
						<!-- Fila 1: Nombre -->
						<div class="">
							<div class="">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-producto-crear" maxlength="45" name="Nombre" oninput="actualizarContadorNombre(this)">
								<p class="" id="contador_Nombre" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
						</div>

						<!-- Fila 2: Precio y Stock -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-precio" class="form-label">Precio</label>
								<input type="number" step="0.01" class="form-control" id="input-precio-producto-crear" name="Precio" value="0" min="0" oninput="actualizarPrecio()">
								<span id="error-precio-producto" class="error-text"></span>
							</div>
							
							<div class="col-md-6">
								<label for="input-stock" class="form-label">Stock Disponible</label>
								<input type="number" class="form-control" id="input-stock-producto-crear" name="StockDisponible" value="0" min="0" oninput="actualizarStock()">
								<span id="error-stock-producto" class="error-text"></span>
							</div>
						</div>

						<!-- Fila 3: Categoria y Proveedor -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-categoria" class="form-label">Categorías disponibles</label>
								<select id="input-categoria-producto-crear" name="idCategoria" class="form-select" style="margin-bottom: 0px !important;" oninput="span()">
									<option selected hidden disabled value="-">Selecciona una categoria</option>
									@foreach (var c in Model.Categorias)
									{
										<option value="@c.IdCategoria">@c.NombreCategoria</option>
									}
								</select>
								<span id="error-producto-categoria" class="error-text" style="margin-bottom: 0px !important;"></span>
							</div>
							<div class="col-md-6">
								<label for="input-proveedor" class="form-label">Proveedores disponibles</label>
								<select id="input-proveedor-producto-crear" name="idProveedor" class="form-select" oninput="span()">
									<option selected hidden disabled value="-">Selecciona un proveedor</option>
									@foreach (var c in Model.Proveedores)
									{
										<option value="@c.IdProveedor">@c.NombreProveedor</option>
									}
								</select>
								<span id="error-producto-proveedor" class="error-text"></span>
							</div>
						</div>


						<!-- Fila 4: URL de Imagen -->
						<div class="row">
							<div class="col-md-12">
								<label for="input-imagen-url" class="form-label">URL de la Imagen</label>
								<input type="url" class="form-control" id="input-imagen-url-producto-crear" name="ImagenUrl" oninput="actualizarImagen()">
								<span id="error-nombre-producto" class="error-text"></span>
								<div class="mt-2 d-flex align-items-center gap-2">
									<button type="button" id="view" class="btn btn-primary" style="visibility: hidden; margin-bottom: 5px !important;" onclick="verImagenCompleta()" title="">
										Ver Imagen
									</button>
								</div>
							</div>
						</div>

						<!-- Fila 5: Descripción -->
						<div class="row mb-2">
							<div class="col-md-12">
								<label for="input-descripcion" class="form-label">Descripción</label>
								<textarea class="form-control" id="input-descripcion-producto-crear" 
								name="Descripcion" 
								rows="5" 
								maxlength="350" 
								oninput="actualizarContadorDesc(this)"
								style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_Create" style="margin-bottom: 5px !important;">0/350 caracteres</p>
							</div>
						</div>

						<!-- Fila 6: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="crearProducto()">Guardar Producto</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade"
	 id="deleteProducto"
	 data-bs-backdrop="static"
	 data-bs-keyboard="false"
	 tabindex="-1"
	 aria-labelledby="staticBackdropLabel"
	 aria-hidden="true"
	 style="background-color: rgba(0, 0, 0, 0.2) !important;">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel">Eliminar Producto</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<h3>¿Desea eliminar este producto?</h3>
				<h4 id="tagProducto"></h4>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
				<button type="button" class="btn btn-primary" onclick="deleteProducto(this)">Confirmar</button>
			</div>
		</div>
	</div>
</div>


<!-- Modal Editar -->
<div class="modal fade" id="editProducto" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modaleditarLabel" aria-hidden="true" style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modaleditarLabel">Editar producto</h5>
				<button type="button" class="btn-close" onclick="cerrarEditar()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-producto">

						<!-- Fila 1: Nombre y Precio -->
						<div class="">
							<div class="">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-producto-editar" maxlength="45" name="Nombre" oninput="actualizarContadorNombreEditar(this)">
								<p class="mt-1" id="contador_Nombre_editar" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
						</div>

						<!-- Fila 2: Precio y Stock -->
						<div class="row mb-2">
							<div class="col-md-6">
								<label for="input-precio" class="form-label">Precio</label>
								<input type="number" step="0.01" class="form-control" id="input-precio-producto-editar" name="Precio" value="0" oninput="actualizarPrecioEditar()">
								<span id="error-precio-producto-editar" class="error-text"></span>
							</div>
							<div class="col-md-6">
								<label for="input-stock" class="form-label">Stock Disponible</label>
								<input type="number" class="form-control" id="input-stock-producto-editar" name="StockDisponible" value="0" oninput="actualizarPrecioEditar()">
								<span id="error-stock-producto-editar" class="error-text"></span>
							</div>
						</div>

						<!-- Fila 3: Categoria y Proveedor -->
						<div class="row mb-2">
							<div class="col-md-6">
								<label for="input-categoria" class="form-label">Categoría</label>
								<select id="input-categoria-producto-editar" name="idCategoria" class="form-select">
									<option selected hidden disabled value="-">Selecciona una categoria</option>
									@foreach (var c in Model.Categorias)
									{
										<option value="@c.IdCategoria">@c.NombreCategoria</option>
									}
								</select>
								<span id="error-producto-categoria-editar" class="error-text"></span>
							</div>
							<div class="col-md-6">
								<label for="input-proveedor" class="form-label">Categoría</label>
								<select id="input-proveedor-producto-editar" name="idProveedor" class="form-select">
									<option selected hidden disabled value="-">Selecciona un proveedor</option>
									@foreach (var c in Model.Proveedores)
									{
										<option value="@c.IdProveedor">@c.NombreProveedor</option>
									}
								</select>
								<span id="error-producto-proveedor-editar" class="error-text"></span>
							</div>
						</div>

						<!-- Fila 4: URL de Imagen -->
						<div class="row mb-2">
							<div class="col-md-12">
								<label for="input-imagen-url" class="form-label">URL de la Imagen</label>
								<input type="url" class="form-control" id="input-imagen-url-producto-editar" name="ImagenUrl" oninput="actualizarImagenEditar()">
								<span id="error-nombre-producto" class="error-text"></span>
								<div class="mt-2 d-flex align-items-center gap-2">
									<button type="button" id="viewEditar" class="btn btn-primary" style="visibility: hidden; margin-bottom: 5px !important;" onclick="verImagenCompletaEditar()" title="">
										Ver Imagen
									</button>
								</div>
							</div>
						</div>

						<!-- Fila 5: Descripción -->
						<div class="row">
							<div class="col-md-12">
								<label for="input-descripcion" class="form-label">Descripción</label>
								<textarea class="form-control" id="input-descripcion-producto-editar" 
								name="Descripcion" 
								rows="5" 
								maxlength="350" 
								oninput="actualizarContadorDescEditar(this)"
								style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_descripcion_editar">0/350 caracteres</p>
							</div>
						</div>

						<!-- Fila 6: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="editarProducto()">Guardar cambios</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal Imagen -->
<div class="modal fade" id="modalImagen" tabindex="-1" aria-labelledby="modalImagenLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
		<div class="modal-content bg-dark text-white" style="max-width: 400px; height: 90vh; margin: auto;">
			<div class="modal-header">
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body d-flex justify-content-center align-items-center MT-1" style="overflow: hidden;">
				<img id="imagenModal" src="" alt="Imagen" class="img-fluid" style="max-width: 100%; max-height: 100%; object-fit: contain;">
			</div>
		</div>
	</div>
</div>


@section scripts {
	<script src="~/js/GestionarProductosScript.js"></script>
}
