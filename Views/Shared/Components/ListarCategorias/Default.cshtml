@using TBD.Models.ViewModels
@using Microsoft.AspNetCore.Identity
@model List<CategoriaViewModel>
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

@if (!User.IsInRole("admin"))
{
	@if (Model.Count() > 0)
	{
		<form method="get" asp-action="BuscarProductos" asp-controller="Producto" asp-route-filter="1" class="d-flex" onsubmit="return validarBusqueda()">
			<div class="container mb-3" style="width:70%">
				<h4>Buscar en todos los productos</h4>
				<div class="d-flex" style="border: 1px solid #53565e; border-radius: 6px; overflow: hidden; max-width: 100%; width: 100%;">
					<select name="idCategoria" class="form-select" style="flex: 0 0 150px; border-radius:0px;">
						<option selected value="">Todas Las Categorías</option>
						@foreach (var c in Model)
						{
							<option value="@c.IdCategoria">@c.NombreCategoria</option>
						}
					</select>
					<input type="text" id="busqueda" name="busqueda" class="form-control bg-light" placeholder="Buscar..." style="border:0px; border-radius:0px; flex: 1 1 auto; min-width: 0; color:black;" />
					<button class="btn px-4" type="submit" style="border-left:1px solid grey; border-bottom-left-radius:0px;border-top-left-radius:0px; background-color: lightblue; flex: 0 0 auto;">
						<i class="fa-solid fa-magnifying-glass"></i>
					</button>
				</div>
			</div>
		</form>
	}
	else
	{
		<h2>No disponible</h2>
	}
	<div class="border-bottom border-secondary mb-3"></div>
}