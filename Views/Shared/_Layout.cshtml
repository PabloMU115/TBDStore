@using Microsoft.AspNetCore.Identity
@using TBD.Models;
@using TBD.Models.ViewModels;
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
    var urlActual = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TBD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TBD.styles.css" asp-append-version="true" />
    <!-- Font Awesome 6.7.2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.7.2/css/all.min.css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

</head>
<body>
    <header class="sticky-top-navbar">
        <nav class="navbar border-bottom box-shadow">
            <div class="d-flex justify-content-between w-100">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Tienda">
                    <img src="~/images/logo.png" alt="Logo home" width="100">
                </a>
                @if (User.IsInRole("usuario"))
                {
                    <div class="nav-user-element mt-2" onclick="window.location.href='/Direcciones'" style="cursor: pointer;">
                        <a class="nav-link" asp-controller="Direccion" asp-action="GestionarDirecciones">Gestionar Direcciones</a>
                    </div>
                }
                <div id="search-items" class="mt-3">
                    @if (!urlActual.Contains("Identity"))
                    {
                        <form class="d-flex" style="border-radius: 6px; overflow: hidden;" method="get" asp-action="BuscarProductos" asp-controller="Producto" asp-route-filter="1" onsubmit="return validarBusqueda()">
                            @await Component.InvokeAsync("BarraDeBusqueda")
                        </form>
                    }
                </div>

                <div class="d-flex mt-3">
                    @if (User.IsInRole("usuario"))
                    {
                        <div onclick="window.location.href='/'" style="cursor: pointer; display: flex; flex-direction: column;">
                            <a class="nav-link" style="font-size:16px !important; margin-bottom: 0px !important;" asp-controller="" asp-action="" aria-expanded="false">
                                <i class="fa-solid fa-heart"></i>
                            </a>
                        </div>

                        <div onclick="window.location.href='/cart'" style="cursor: pointer;">
                            @await Component.InvokeAsync("TotalCarrito")
                        </div>
                    }

                    <!-- Login / cuenta -->
                    <partial name="_LoginPartial" />
                </div>
            </div>

            <!-- Barra de búsqueda para dispositivos móviles -->
            <div class="d-block d-md-none mt-2 w-100">
                @if (!urlActual.Contains("Identity"))
                {
                    <form class="d-flex" style="border: 1px solid #53565e; border-radius: 6px; overflow: hidden;" method="get" asp-action="BuscarProductos" asp-controller="Producto" asp-route-filter="1" onsubmit="return validarBusqueda()">
                        @await Component.InvokeAsync("BarraDeBusqueda")
                    </form>
                }
            </div>
        </nav>
    </header>
	<div id="main-container" class="container-fluid mx-0 px-0">
		<main role="main" class="">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container" style="max-height: 20px;">
			&copy; 2025 - TBD - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
