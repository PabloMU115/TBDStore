<!-- Modal crear -->
<div class="modal fade" id="ModalCrear" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalCrearLabel" aria-hidden="true" style="height: 100vh;background-color: transparent !important; backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCrearLabel">Agregar dirección nueva</h5>
                <button type="button" class="btn-close" onclick="cerrarCrear()" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="height: 180px;">
                <div class="container" id="formulario-container"> 
                    <div id="formulario-direccion">
                        <div class="" style="justify-items: center;">
                            <div>
                                <h2 id="desc-orden"></h2>
                                <h4 id="desc-orden-disclaimer"></h4>
                            </div>
                            <div class="mt-3" style="position: absolute;" id="cancelar">
                                <button class="btn-eliminar-orden btn-danger" onclick="cancelar()">
                                    <h5>Cancelar orden</h5>
                                </button>
                            </div> 
                            <div class="mt-1" style="position: absolute;" id="confirmar">
                                <button class="btn-confirmar-orden" onclick="confirmar()">
                                    <h5>Confirmar recibido</h5>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let ordenActual;
    function cancelar(){
        fetch("/api/ordenapi/cancel", {
            method: "PUT",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(ordenActual)
        })
            .then(response => {
                if(response.ok){
                    location.reload();
                }
            })
            .catch(error => {
                console.error("Error al hacer PUT:", error);
            }); 
    }

    function OpenModal(opcion, id){
        ordenActual = id; 
        $("#ModalCrear").modal("show");
        if(opcion === "cancelar"){
            document.getElementById("cancelar").style.display = "";
            document.getElementById("modalCrearLabel").innerText = "Cancelar orden";
            document.getElementById("desc-orden").innerText="¿Desea cancelar esta orden?";
            document.getElementById("desc-orden-disclaimer").innerText="(Para reembolzar esta orden deberá contactarse con el número de servicio al cliente y seguir las instrucciones)";
            document.getElementById("confirmar").style.display = "none";
        }
        else{
            document.getElementById("confirmar").style.display = "";
            document.getElementById("modalCrearLabel").innerText = "Confirmar recepción";
            document.getElementById("desc-orden").innerText="¿Desea confirmar esta orden como recibida?";
            document.getElementById("desc-orden-disclaimer").innerText="(Al aceptar como recibida, está confirmando que ya se encuentra en posesión de la orden correpondiente)";
            document.getElementById("cancelar").style.display = "none";
        }
    }

    function cerrarCrear() {
	    $("#ModalCrear").modal("hide");
    }

    function actualizarContadorNombre(textarea) {
	    const errorSpan = document.getElementById("contador_Nombre");
	    document.getElementById("error-nombre").innerText = "";
	    if (document.getElementById("input-nombre-direccion").value !== "") {
		    errorSpan.className = "mt-1";
		    errorSpan.textContent = `${textarea.value.length}/45 caracteres`;
	    }
	    else {
		    errorSpan.textContent = `${textarea.value.length}/45 caracteres`;
	    }

    }

    function confirmar(){
        fetch("/api/ordenapi/confirm", {
            method: "PUT",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(ordenActual)
        })
            .then(response => {
                if(response.ok){
                    location.reload();
                }
            })
            .catch(error => {
                console.error("Error al hacer PUT:", error);
            });
    }

    function toggleCollapse(tipo) {
        const collapse = document.getElementById("collapse-" + tipo);
        const toggleBtn = document.getElementById("boton-toggle-" + tipo);

        // Si está expandido, lo colapsamos, y viceversa
        if (collapse.classList.contains("collapsed")) {
            collapse.classList.remove("collapsed");
            collapse.style.border="1px solid gray";
            toggleBtn.innerHTML = "<h2>Mostrar menos <i class='fa-solid fa-angles-up'></i></h2>";
        } else {
            collapse.classList.add("collapsed");
            collapse.style.border="0px";
            toggleBtn.innerHTML = "<h2>Mostrar más <i class='fa-solid fa-angles-down'></i></h2>";
        }
    }
</script>