@using TBD.Models.ViewModels
@model GestionarCategoriasViewModel
@{
	int ap = 0;
}
<!-- Botón para abrir el modal -->
<div class="container card p-4" style="color:white;">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Listado de Categorias</h2>
		<button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#ModalCrear">
			<i class="fa-solid fa-square-plus"></i> Agregar Categoria
		</button>
	</div>

	<div class="table-responsive">
		<table id="tabla-categoria" class="display table table-bordered table-hover">
			<thead>
				<tr>
					<th class="text-center">ID</th>
					<th class="text-center">Nombre</th>
					<th class="text-center" style="width:120px !important;">Cantidad de Productos</th>
					<th class="text-center">Opciones</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var p in Model.Categorias)
				{
					<tr class="tr-tabla">
						<td class="id" id="@p.IdCategoria">
							@p.IdCategoria
						</td>
						<td>
							<a class="nombre" id="@p.NombreCategoria"
							   asp-controller="Categoria"
							   asp-action="Index"
							   asp-route-id="@p.IdCategoria"
							   asp-route-nombre="@p.NombreCategoria"
							   asp-route-pageNumber="1"
							   asp-route-showAll="False"
							   asp-route-filter="1"
							   asp-route-idCategoria="@p.IdCategoria">@p.NombreCategoria</a>
						</td>
						<td id="contador_@p.IdCategoria">@Model.Productos[ap]</td>
						<td>
							<button class="btn-editarCategoria btn-warning" onclick="openEdit(this)"><i class="fa-solid fa-pen-to-square"></i></button>
							<button class="btn-eliminarCategoria btn-danger" onclick="openDelete(this)"><i class="fa-solid fa-trash-can"></i></button>
						</td>
					</tr>
					ap+=1;
				}
			</tbody>
		</table>
	</div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="ModalCrear" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalCrearLabel" aria-hidden="true"
	 style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalCrearLabel">Agregar un Categoria nueva</h5>
				<button type="button" class="btn-close" onclick="cerrarCrear()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-categoria">
						<!-- Fila 1: Nombre -->
						<div class="">
							<div class="">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-categoria-crear" maxlength="45" name="Nombre" oninput="actualizarContadorNombre(this)">
								<p class="" id="contador_Nombre" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
						</div>

						<!-- Fila 2: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="crearCategoria()">Guardar Categoria</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade"
	 id="deleteCategoria"
	 data-bs-backdrop="static"
	 data-bs-keyboard="false"
	 tabindex="-1"
	 aria-labelledby="staticBackdropLabel"
	 aria-hidden="true"
	 style="background-color: rgba(0, 0, 0, 0.2) !important;">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel">Eliminar Categoria</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<h3>¿Desea eliminar esta categoria?</h3>
				<h4 id="tagCategoria"></h4>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
				<button type="button" class="btn btn-primary" onclick="deleteCategoria(this)">Confirmar</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="editCategoria" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modaleditarLabel" aria-hidden="true" style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modaleditarLabel">Editar categoria</h5>
				<button type="button" class="btn-close" onclick="cerrarEditar()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-categoria">

						<!-- Fila 1: Nombre -->
						<div class="">
							<div class="">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-categoria-editar" maxlength="45" name="Nombre" oninput="actualizarContadorNombreEditar(this)">
								<p class="mt-1" id="contador_Nombre_editar" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
						</div>

						<!-- Fila 2: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="editarCategoria()">Guardar cambios</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script src="~/js/GestionarCategoriasScript.js"></script>
}
