@using TBD.Models.ModelRequest;
@model AllPedidosRequest
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@if (Model.ordenes.Count == 0)
{
    <h1 style="margin-left: 10px;">No posee pedidos para consultar...</h1>
}

@if (Model.ordenes.Where(p => p.Estado == EstadoPedido.Pendiente).Count() > 0)
{
    <div class="contenedor-orders">
        <div style="margin-left: 10px; margin-bottom: 10px;" class="d-flex">
            <h2 style="width: 250px;">Ordenes pendientes</h2>
            <button id="boton-toggle-pendientes" class="boton-toggle" onclick="toggleCollapse('pendientes')"><h2>Mostrar menos <i class="fa-solid fa-angles-up"></i></h2></button>
        </div>

        <div id="collapse-pendientes" class="colapsable" style="border: 1px solid gray; border-radius: 8px;">
            <div class="colapsable-content d-flex flex-column gap-4">
                @foreach (var o in Model.ordenes.Where(p => p.Estado == EstadoPedido.Pendiente))
                {
                    <div class="grid-orden">
                        <div style="flex: 1; margin-right: 0px; max-width:90%; justify-items:center;">
                            <h4>Número de orden: @o.idOrden</h4>
                            <h3>Fecha en que se realizó el pedido: @o.fechaPedido.ToString().Split(" ")[0]</h3>
                            <h4>Id transacción paypal: @o.paypalID</h4>
                            <div class="items-orders mb-3">
                                @for (var i = 0; i < Model.productos[o.idOrden].Count(); i++)
                                {
                                    <div class="d-flex flex-column">
                                        <a class="item-order-producto"
                                           asp-controller="Producto"
                                           asp-action="GetProducto"
                                           asp-route-id="@Model.productos[o.idOrden][i].IdProducto"
                                           asp-route-nombre="@Model.productos[o.idOrden][i].NombreProducto"
                                           asp-route-idCategoria="@Model.productos[o.idOrden][i].IdCategoria">
                                            <h4>@Model.productos[o.idOrden][i].NombreProducto</h4>
                                            <img class="img-order-producto" src="@Model.productos[o.idOrden][i].ImagenUrl">
                                        </a>
                                        <h5 class="text-center">Cantidad: @Model.cantidades[o.idOrden][i]</h5>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mt-2" style="max-width: 300px; min-width: 300px;">
                            <h2>Dirección de envío:</h2>
                            @foreach (var z in o.direccion.Split("||"))
                            {
                                <div style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; font-size: 16px; max-width: 300px; min-width: 300px;">
                                    @z
                                </div>
                            }
                        </div>
                        <a class="btn-confirmar-orden mt-2 mb-3"
                           onclick="OpenModal('confirmar','@o.idOrden')">
                            <i class="fa-solid fa-check"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

