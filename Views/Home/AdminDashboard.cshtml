<!-- Modal crear -->
<div class="modal fade" id="ModalCrear" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalCrearLabel" aria-hidden="true" style="height: 100vh;background-color: transparent !important; backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCrearLabel"></h5>
                <button type="button" class="btn-close" onclick="cerrarCrear()" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="height: 180px;">
                <div class="container" id="formulario-container">
                    <div id="formulario-direccion">
                        <div class="" style="justify-items: center;">
                            <h4 id="form-label" class="form-label"></h4>
                            <div id="form-input">
                                <label for="input-nombre-direccion" class="form-label">Inserte el número de guía de la orden para confirmar el envío</label>
                                <input type="text" class="form-control" id="input-numero-Guia" maxlength="45" name="numeroGuia" oninput="actualizarContadorNombre(this)">
                                <p class="" id="contador_Nombre" style="margin-bottom: 5px !important;">0/45 caracteres</p>
                                <span id="error-nombre" class="error-text"></span>
                            </div>
                            <div class="mt-3" style="position: absolute;" id="reembolso">
                                <button class="btn-reembolsar-orden" onclick="reembolso()">
                                    <h5>Reembolsar orden</h5>
                                </button>
                            </div>
                            <div class="mt-1" style="position: absolute;" id="confirmar">
                                <button class="btn-confirmar-orden" onclick="confirmarEnvio()">
                                    <h5>Confirmar recibido</h5>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script> 
    let ordenActual;
    function reembolso(){
        fetch("/api/ordenapi/confirmarReembolso", {
            method: "PUT",
            headers: { 
                "Content-Type": "application/json"
            },
            body: JSON.stringify(ordenActual)
        })
            .then(response => {
                if(response.ok){
                    location.reload();
                }
            })
            .catch(error => {
                console.error("Error al hacer PUT:", error);
            });
    }

    function OpenModal(opcion, id){
        ordenActual = id;
        $("#ModalCrear").modal("show");
        switch(opcion){
            case("reembolso"): {
                document.getElementById("reembolso").style.display = "";
                document.getElementById("form-label").style.display = "";
                document.getElementById("form-label").innerText = "¿Desea confirmar el reembolso de esta orden?";
                document.getElementById("modalCrearLabel").innerText = "Confirmar reembolso.";
                document.getElementById("form-input").style.display = "none";
                document.getElementById("confirmar").style.display = "none";
            }
            break;
            case("confirmar"): {
                document.getElementById("confirmar").style.display = "";
                document.getElementById("form-input").style.display = "";
                document.getElementById("form-label").style.display = "none";
                document.getElementById("reembolso").style.display = "none";
            }
            break;
        }
    }

    function cerrarCrear() {
        $("#ModalCrear").modal("hide");
    }

    function actualizarContadorNombre(textarea) {
        const errorSpan = document.getElementById("contador_Nombre");
        document.getElementById("error-nombre").innerText = "";
        if (document.getElementById("input-numero-Guia").value !== "") {
            errorSpan.className = "mt-1";
            errorSpan.textContent = `${textarea.value.length}/45 caracteres`;
        }
        else {
            errorSpan.textContent = `${textarea.value.length}/45 caracteres`;
        }

    }

    function confirmarEnvio(){
        fetch("/api/ordenapi/confirmarEnvio", {
            method: "PUT",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                idOrden : ordenActual,
                numeroDeGuia : document.getElementById("input-numero-Guia").value
            })
        })
            .then(response => {
                if(response.ok){
                    location.reload();
                }
            })
            .catch(error => {
                console.error("Error al hacer PUT:", error);
            });
    }

    function toggleCollapse(tipo) {
        const collapse = document.getElementById("collapse-" + tipo);
        const toggleBtn = document.getElementById("boton-toggle-" + tipo);

        // Si está expandido, lo colapsamos, y viceversa
        if (collapse.classList.contains("collapsed")) {
            collapse.classList.remove("collapsed");
            collapse.style.border="1px solid gray";
            toggleBtn.innerHTML = "<h2>Mostrar menos <i class='fa-solid fa-angles-up'></i></h2>";
        } else {
            collapse.classList.add("collapsed");
            collapse.style.border="0px";
            toggleBtn.innerHTML = "<h2>Mostrar más <i class='fa-solid fa-angles-down'></i></h2>";
        }
    }
</script>
