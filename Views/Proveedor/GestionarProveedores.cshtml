@using TBD.Models.ViewModels
@model GestionarProveedoresViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
	int ap = 0;
	if (User.IsInRole("admin"))
	{
		Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
	}
}
<!-- Botón para abrir el modal -->
<div class="container card p-4" style="color:white;">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Listado de Proveedores</h2>
		<button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#ModalCrear">
			<i class="fa-solid fa-square-plus"></i> Agregar Proveedor
		</button>
	</div>

	<div class="table-responsive">
		<table id="tabla-proveedor" class="display table table-bordered table-hover">
			<thead>
				<tr>
					<th class="text-center">ID</th>
					<th class="text-center">Nombre</th>
					<th class="text-center" style="width:120px !important;">Cantidad de Productos</th>
					<th class="text-center">Opciones</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var p in Model.Proveedores)
				{
					<tr class="tr-tabla">
						<td class="id" id="@p.IdProveedor">@p.IdProveedor</td>
						<td class="nombre" id="@p.NombreProveedor">@p.NombreProveedor</td>
						<td id="contador_@p.IdProveedor">@Model.Productos[ap]</td>
						<td>
							<button class="btn-editarProveedor btn-warning" onclick="openEdit(this)">
								<i class="fa-solid fa-pen-to-square"></i>
							</button>
							<button class="btn-eliminarProveedor btn-danger" onclick="openDelete(this)">
								<i class="fa-solid fa-trash-can"></i>
							</button>
						</td>
					</tr>
					ap += 1;
				}
			</tbody>
		</table>
	</div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="ModalCrear" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalCrearLabel" aria-hidden="true" style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalCrearLabel">Agregar un Proveedor nuevo</h5>
				<button type="button" class="btn-close" onclick="cerrarCrear()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-proveedor">
						<!-- Fila 1: Nombre -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-proveedor-crear" maxlength="45" name="Nombre" oninput="actualizarContadorNombre(this)">
								<p class="" id="contador_Nombre" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
							<div class="col-md-6">
								<label for="input-contacto" class="form-label">Número de contacto</label>
								<input type="text" class="form-control" id="input-contacto-proveedor-crear" maxlength="45" name="contacto">
							</div>
						</div>

						<!-- Fila 2: Email -->
						<div class="mb-3">
							<label for="input-email-proveedor-crear" class="form-label">Dirección de correo electrónico</label>
							<input type="email" class="form-control" id="input-email-proveedor-crear" maxlength="45" name="email">
						</div>

						<!-- Fila 3: Descripcion y Dirección -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-descripcion" class="form-label">Descripción</label>
								<textarea class="form-control" id="input-descripcion-proveedor-crear" name="Descripcion" rows="5" maxlength="350" oninput="actualizarContadorDesc(this)" style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_Create_Desc" style="margin-bottom: 5px !important;">0/350 caracteres</p>
							</div>
							<div class="col-md-6">
								<label for="input-direccionr" class="form-label">Dirección</label>
								<textarea class="form-control" id="input-direccion-proveedor-crear" name="Direccion" rows="5" maxlength="350" oninput="actualizarContadorDir(this)" style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_Create_Dir" style="margin-bottom: 5px !important;">0/350 caracteres</p>
							</div>
						</div>

						<!-- Fila 4: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="crearProveedor()">Guardar Proveedor</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="editProveedor" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modaleditarLabel" aria-hidden="true" style="background-color: transparent !important; backdrop-filter: blur(10px);">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modaleditarLabel">Editar proveedor</h5>
				<button type="button" class="btn-close" onclick="cerrarEditar()" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<div class="container" id="formulario-container">
					<div id="formulario-proveedor">
						<!-- Fila 1: Nombre -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-nombre" class="form-label">Nombre</label>
								<input type="text" class="form-control" id="input-nombre-proveedor-editar" maxlength="45" name="Nombre" oninput="actualizarContadorNombre(this)">
								<p class="" id="contador_Nombre_editar" style="margin-bottom: 5px !important;">0/45 caracteres</p>
							</div>
							<div class="col-md-6">
								<label for="input-contacto" class="form-label">Número de contacto</label>
								<input type="text" class="form-control" id="input-contacto-proveedor-editar" maxlength="45" name="contacto">
							</div>
						</div>

						<!-- Fila 2: Email -->
						<div class="mb-3">
							<label for="input-email-proveedor-editar" class="form-label">Dirección de correo electrónico</label>
							<input type="email" class="form-control" id="input-email-proveedor-editar" maxlength="45" name="email">
						</div>

						<!-- Fila 3: Descripcion y Dirección -->
						<div class="row mb-3">
							<div class="col-md-6">
								<label for="input-descripcion" class="form-label">Descripción</label>
								<textarea class="form-control" id="input-descripcion-proveedor-editar" name="Descripcion" rows="5" maxlength="350" oninput="actualizarContadorDescEditar(this)" style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_edit_Desc" style="margin-bottom: 5px !important;">0/350 caracteres</p>
							</div>
							<div class="col-md-6">
								<label for="input-direccionr" class="form-label">Dirección</label>
								<textarea class="form-control" id="input-direccion-proveedor-editar" name="Direccion" rows="5" maxlength="350" oninput="actualizarContadorDirEditar(this)" style="resize: none;"></textarea>
								<p class="ms-lg-2 mt-1" id="contador_edit_Dir" style="margin-bottom: 5px !important;">0/350 caracteres</p>
							</div>
						</div>

						<!-- Fila 4: Botón -->
						<div class="row">
							<div class="col text-center">
								<button class="btn btn-success" id="btn-guardar" onclick="editarProveedor()">Guardar Proveedor</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="deleteProveedor" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true" style="background-color: rgba(0, 0, 0, 0.2) !important;">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel">Eliminar Proveedor</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<h3>¿Desea eliminar este proveedor?</h3>
				<h4 id="tagProveedor"></h4>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
				<button type="button" class="btn btn-primary" onclick="deleteProveedor()">Confirmar</button>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script src="~/js/GestionarProveedoresScript.js"></script>
}
