                        }
                    }
                </section>
            </div>
        </div> *@
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function mostrar(){
        var x = document.getElementById("password");
        var z = document.getElementById("confirmPassword");
        if (x.type === "password") {
          x.type = "text";
          z.type = "text";
        } else {
          x.type = "password";
          z.type = "password";
        }
        }
    </script>
}
