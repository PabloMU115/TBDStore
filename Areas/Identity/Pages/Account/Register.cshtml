                                <p>
                                    No hay servicios de autenticación externos configurados. Consulta este
                                    <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">artículo</a> para habilitarlos.
                                </p>
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Iniciar sesión con @provider.DisplayName">
