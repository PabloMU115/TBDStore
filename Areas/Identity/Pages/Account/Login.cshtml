@page
@model LoginModel

@{
	ViewData["Title"] = "Log in";
}

<div class="container" style="margin-bottom:70px !important;">
	<div class="row">
		<div class="">
			<div class="formIdentity card shadow p-4">
				<form id="account" method="post">
					<h2 class="text-center">Iniciar sesión</h2>
					<hr />
					<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
					<div class="form-floating mb-3">
						<input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
						<label asp-for="Input.Email" class="register-form-label">Correo Electrónico</label>
						<span asp-validation-for="Input.Email" class="text-danger"></span>
					</div>
					<div class="form-floating mb-3">
						<input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
						<label asp-for="Input.Password" class="register-form-label">Contraseña</label>
						<span asp-validation-for="Input.Password" class="text-danger"></span>
					</div>
					<div class="checkbox mb-3">
						<label asp-for="Input.RememberMe" class="form-label">
							<input class="form-check-input" asp-for="Input.RememberMe" />
							@Html.DisplayNameFor(m => m.Input.RememberMe)
						</label>
					</div>
					<div>
						<button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary" style="border: 2px solid transparent !important;"><h4>Iniciar sesión</h4></button>
					</div>
				</form>
				<div class="mb-3">
					<label class="form-label text-center w-100 mt-2">¿No tienes cuenta?</label>
					<a asp-page="/Account/Register" asp-area="Identity" class="registerLogin btn btn-success w-100" style="border: 2px solid transparent !important;"><h4>Crear cuenta</h4></a>
				</div>
				<div>
					<p>
						<a id="forgot-password" asp-page="./ForgotPassword">Recuperar contraseña</a>
					</p>
					<p>
						<a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Volver a enviar correo de confirmación</a>
					</p>
				</div>
			</div>
		</div>
		@* <div class="col-md-6">
			<div class="formIdentity card shadow p-4 h-100">
				<section>
					<h3>Use another service to log in.</h3>
