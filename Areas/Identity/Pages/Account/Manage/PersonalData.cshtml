@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Esta cuenta contiene información personal que nos ha sido brindada por su parte, esta página le permite borrar esta información.</p>
        <p>
            <strong>Tome en cuenta que borrar esta cuenta resultará en la permanente perdida de su información, esta acción no puede ser revertida!</strong>
        </p>
        @* <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Download</button>
        </form> *@
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Eliminar cuenta</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
